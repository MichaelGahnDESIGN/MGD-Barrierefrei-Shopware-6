<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Eigene Dienste bleiben klein; die Shopware-Konfiguration ist die einzige Datenquelle. -->
        <service id="MgdBarrierefrei\Update\GitHubReleaseChecker"/>
        <service id="MgdBarrierefrei\Administration\Controller\UpdateController" public="true">
            <argument type="service" id="MgdBarrierefrei\Update\GitHubReleaseChecker"/>
        </service>
        <!-- Weitere Plugins: Feed von theme.michael-gahn.de, nur Admin -->
        <service id="MgdBarrierefrei\Catalog\PsrCatalogCache">
            <argument type="service" id="cache.object"/>
        </service>
        <service id="MgdBarrierefrei\Catalog\FeedNormalizer">
            <argument type="collection"><argument>shopware</argument><argument>shopware6</argument></argument>
            <argument>plugin-barrierefrei-shopware</argument>
        </service>
        <service id="MgdBarrierefrei\Catalog\PluginCatalog">
            <argument type="service" id="MgdBarrierefrei\Catalog\PsrCatalogCache"/>
            <argument type="service" id="MgdBarrierefrei\Catalog\FeedNormalizer"/>
        </service>
        <service id="MgdBarrierefrei\Administration\Controller\CatalogController" public="true">
            <argument type="service" id="MgdBarrierefrei\Catalog\PluginCatalog"/>
        </service>
        <service id="MgdBarrierefrei\Storefront\AccessibilityController" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>
    </services>
</container>
