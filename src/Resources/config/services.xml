<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <!-- Baukasten aus MichaThemeV5-Pro > src/Kit (bin/build-plugin-kit.php) - Info, Updates, Weitere Plugins, Installation melden -->
    <imports>
        <import resource="../../Kit/Platform/Shopware/Resources/config/services.xml"/>
    </imports>
    <services>
        <!-- alter GitHub-Update-Check + alte Liste Weitere Plugins nicht mehr angemeldet, löschen in der Endversion -->
        <service id="MgdBarrierefrei\Storefront\AccessibilityController" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>
        <!-- Free-Lizenz Anmeldung bei Install/Aktivieren/Update + Schalter aus der Plugin-Konfig -->
        <service id="MgdBarrierefrei\InstallReport\InstallReporter">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <!-- tägliche Meldung jetzt per PingTask aus dem Baukasten, eigener Task raus -->
        <service id="MgdBarrierefrei\InstallReport\InstallSwitchSubscriber">
            <argument type="service" id="MgdBarrierefrei\InstallReport\InstallReporter"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
