{# Config fürs Widget - Oberfläche baut das JS selbst im Shadow DOM #}
{% set c = 'MgdBarrierefrei.config.' %}
{% set accent = config(c ~ 'accentColor')|default('#b91c1c') %}
{% set lang = config(c ~ 'defaultLang')|default('auto') %}
{% set theme = config(c ~ 'defaultTheme')|default('auto') %}
{% set de = config(c ~ 'buttonLabel')|default('')|striptags|trim|slice(0, 80) %}
{% set en = config(c ~ 'buttonLabelEn')|default('')|striptags|trim|slice(0, 80) %}
{% set offset = config(c ~ 'offset')|default(0) %}
{% set offset = offset matches '/^\\d+$/' ? min(200, offset) : 0 %}
{% set mgdA11y = {
    position: config(c ~ 'position') == 'right' ? 'right' : 'left',
    accent: accent matches '/^#[0-9a-fA-F]{6}$/' ? accent : '#b91c1c',
    lang: lang in ['auto', 'de', 'en'] ? lang : 'auto',
    theme: theme in ['auto', 'light', 'dark'] ? theme : 'auto',
    labels: { de: de == 'Barrierefreiheit' ? '' : de, en: en == 'Accessibility' ? '' : en },
    statementUrl: path('frontend.mgd_barrierefrei.statement'),
    offset: offset + 0
} %}
{# 335 = JSON_HEX_TAG|AMP|APOS|QUOT|UNESCAPED_SLASHES|UNESCAPED_UNICODE, sicher im Script-Tag #}
<script type="application/json" id="mgd-barrierefrei-config">{{ mgdA11y|json_encode(335)|raw }}</script>
